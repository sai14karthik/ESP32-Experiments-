# Local only — copy from this file or let scripts/flash_csi_between.sh write it.
CONFIG_EXAMPLE_WIFI_SSID="YOUR_WIFI_SSID"
CONFIG_EXAMPLE_WIFI_PASSWORD="YOUR_WIFI_PASSWORD"
CONFIG_EXAMPLE_WIFI_AUTH_WPA2_PSK=y

# Sense board TCP → Mac Mini (peer ignores; depends on SENSE role)
CONFIG_CSI_TCP_ENABLE=y
CONFIG_CSI_TCP_HOST="10.128.93.13"
CONFIG_CSI_TCP_PORT=9055

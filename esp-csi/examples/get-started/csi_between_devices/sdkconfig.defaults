#
# Espressif 4.2 — CSI between two STAs on the same AP.
# Both boards join Wi‑Fi and ping the gateway. The sense board enables
# promiscuous RX and filters CSI by the peer board's fixed MAC.
#
CONFIG_ESP32_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP32_WIFI_AMPDU_TX_ENABLED=
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=128
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=128

CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESPTOOLPY_MONITOR_BAUD_115200B=y
CONFIG_ESPTOOLPY_MONITOR_BAUD=115200

CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# Placeholder — override with sdkconfig.defaults.local (gitignored)
CONFIG_EXAMPLE_WIFI_SSID="YOUR_WIFI_SSID"
CONFIG_EXAMPLE_WIFI_PASSWORD="YOUR_WIFI_PASSWORD"
CONFIG_EXAMPLE_WIFI_AUTH_WPA2_PSK=y

# Default build role; flash_csi_between.sh overrides per board via sdkconfig
CONFIG_CSI_BETWEEN_ROLE_SENSE=y

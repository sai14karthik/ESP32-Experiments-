# Machine-local Wi-Fi + TCP ingest host for csi_recv_router (do not commit).
# Copy to sdkconfig.defaults.local next to sdkconfig.defaults, then:
#   idf.py fullclean
#   rm -f sdkconfig
#   idf.py set-target esp32c5
#   idf.py build flash monitor
#
# Or use helpers from repo root:
#   ./scripts/set_csi_wifi.sh "SSID" "PASSWORD" [port]
#   ./scripts/set_csi_tcp_host.sh 10.128.93.x [9055] [serial-port]

CONFIG_EXAMPLE_WIFI_SSID="office-or-home-ssid"
CONFIG_EXAMPLE_WIFI_PASSWORD="office-or-home-password"
CONFIG_EXAMPLE_WIFI_AUTH_WPA2_PSK=y

# Wireless CSI ingest (USB serial still prints CSI_DATA).
# Host = LabPSK IP of Mac Mini running: ./run_ingest.sh --listen-tcp 9055
CONFIG_CSI_TCP_ENABLE=y
CONFIG_CSI_TCP_HOST="10.128.93.1"
CONFIG_CSI_TCP_PORT=9055

# Waveshare ESP32-S3-AUDIO-Board already on the bench.
# Wake phrase is what you say. Display text is what the cloud hears.
SPEAKER_ID=katie
WAKE_PHRASE="hello katie"
WAKE_DISPLAY="Hello Katie"
# 1-99. Smaller hears quieter speech. 5 is 0.05.
WAKE_THRESHOLD=5
BOARD=waveshare/esp32-s3-audio-board
LANGUAGE=en-US
XIAOZHI_TAG=v2.5.2
PORT=/dev/cu.usbmodem101

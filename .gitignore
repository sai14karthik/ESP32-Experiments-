# =============================================================================
# Whitelist: only ESP-type project trees are tracked for GitHub.
# Everything else at the repo root is ignored (local lab clutter stays local).
# =============================================================================

# Ignore all top-level entries by default
/*

# Repo meta (keep)
!/.gitignore
!/.gitattributes
!/.gitmodules
!/README.md

# --- ESP-type project folders (source, examples, speaker images) ---
!/firmware/
!/wifi_speaker/
!/speakers/
!/esp-csi/
!/esp32-camera/
!/esp32cam-ready/
!/esp32cam-rtsp/
!/ESP32-CSI-Tool/
!/ESP32-CSI-Tool-master/
!/ESP32-RTSP/
!/ESP32-RTSPServer/
!/ESP32_RTSP/
!/Micro-RTSP/
!/SeeedStudio-XIAO-ESP32S3-Sense-camera/
!/luma-esp32-ai-assistant/
!/esphome-wifi-csi/
!/espectre/
!/espectre-sense/
!/csi/
!/contactless_respiration/

# =============================================================================
# Still ignore junk / secrets / build artifacts *inside* allowed trees
# =============================================================================

# OS / editor
.DS_Store
Thumbs.db
.AppleDouble
.idea/
.cache/
.vscode/
.cursor/
.agents/

# Python (host tools that may live next to firmware)
.venv/
**/.venv/
**/.venv-ml/
__pycache__/
*.py[cod]
*$py.class
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/

# Local secrets / machine paths (never commit)
.env
*.key
*.pem
*.crt
*.p12
*.der
auto.crt
auto.key
**/secrets.h
**/lab_wifi.local.h
**/sdkconfig.defaults.local
**/sdkconfig.peer
**/sdkconfig.sense
eim_config.toml
network_commands.txt

# ESP-IDF / Arduino / PIO build trees (absolute paths, not portable)
**/build/
**/build-*/
**/.pio/
**/managed_components/
sdkconfig
sdkconfig.old
**/sdkconfig
**/sdkconfig.old
compile_commands.json
.clangd/

# Firmware binaries from local compiles (keep packaged flash images under
# speakers/ and wifi_speaker/; ignore ad-hoc dumps at firmware/*.bin)
*.elf
*.map
*.o
*.d
*.a
*.exe
*_flashed.bin
*.ino.merged.bin
*.ino.bin
/firmware/*.bin

# Logs / archives
*.log
*.zip

# Nested local clones already covered by /* (listed for clarity if re-added)
/whisper/
/whisper-diarization/
/WhisperLiveKitDiarization/
/rpm-main/
/gpu-cluster-main/
/wifi-sensing-main/
/wifi sensing/
/docs_nivdia/
/docs_nvidia/
/materials/
/heartrate estimation/
/Hands-on Wireless Sensing/
/docs/
/data/
/mediamtx/
/mediamtx-repo/
/csi_pipeline/
/csi_pipeline_new/
/csi_presence_c5/
/presence_detection/
/healthcare_pose_activity/
/scripts/
/runs/

#pragma once

// ── WiFi credentials template ────────────────────────────────────────────
// Copy this file to "secrets.h" (same folder) and fill in your network.
//
//   cp include/secrets.h.example include/secrets.h
//
// secrets.h is gitignored so your password never gets committed.
//
// NOTE: The ESP32-C6 radio is 2.4 GHz only. WIFI_SSID must be a 2.4 GHz
// network (or a combined-band SSID that exposes 2.4 GHz).

#define WIFI_SSID     "your-2.4GHz-network-name"
#define WIFI_PASSWORD "your-wifi-password"

// ── CSI collector (UDP) ──────────────────────────────────────────────────
// LAN IP and port of the machine running the collector. The collector
// listens on udp/5566 (collector/src/main.cpp).

#define COLLECTOR_IP    "192.168.1.100"
#define COLLECTOR_PORT  5566

name: "bls_ar"
backend: "python"
#max_batch_size: 1

input [
{
    name: "poses"
    data_type: TYPE_FP32
    dims: [ 18, 3]
}
]

input [
{
    name: "bbox"
    data_type: TYPE_FP32
    dims: [ -1 ]
}
]

input [
{
    name: "tracked_id"
    data_type: TYPE_INT32
    dims: [ -1 ]
}
]

input [
{
    name: "start_frame"
    data_type: TYPE_UINT8
    dims: [ 1 ]
}
]

output [
{
    name: "predicted_index"
    data_type: TYPE_INT32
    dims: [ 1 ]
}
]

output [
{
    name: "ar_confidence"
    data_type: TYPE_FP32
    dims: [ 1 ]
}
]
output [
{
    name: "action_predicted_flag"
    data_type: TYPE_INT32
    dims: [ 1 ]
}
]

instance_group [{ count: 1 kind: KIND_GPU gpus:[0]}]

parameters: { key: "FORCE_CPU_ONLY_INPUT_TENSORS" value: {string_value:"no"}}


response_cache {
  enable: true
}

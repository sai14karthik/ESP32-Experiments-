name: "bls_hpe"
backend: "python"
max_batch_size: 1
input [
  {
    name: "image"
    data_type: TYPE_UINT8
    dims: [ 540, 960, 3]
  },
  {
    name: "bbox"
    data_type: TYPE_FP32
    dims: [ 4096 ]
  },
  {
    name: "tracked_id"
    data_type: TYPE_INT32
    dims: [ 1024 ]
  }
]
output [
{
    name: "poses"
    data_type: TYPE_FP32
    dims: [-1, 18, 3 ]
}
]

output [
{
    name: "bbox"
    data_type: TYPE_FP32
    dims: [ -1 ]
}
]

output [
{
    name: "tracked_id"
    data_type: TYPE_INT32
    dims: [ -1 ]
}
]


instance_group [{ count: 1 kind: KIND_GPU gpus:[0]}]

parameters: { key: "FORCE_CPU_ONLY_INPUT_TENSORS" value: {string_value:"no"}}


response_cache {
  enable: true
}

name: "ar"
platform: "tensorrt_plan"
max_batch_size: 1
input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [ 3, 64, 18, 1 ]
  }
]
output [
  {
    name: "pred_logits"
    data_type: TYPE_FP32
    dims: [ 4 ]
  }
]

instance_group [{ count: 1 kind: KIND_GPU gpus:[0]}]

parameters: { key: "FORCE_CPU_ONLY_INPUT_TENSORS" value: {string_value:"no"}}


response_cache {
  enable: true
}
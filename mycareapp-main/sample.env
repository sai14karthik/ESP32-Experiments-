# Copy this file to .env, then edit the values.
PROJECT_NAME=mycareapp
BASE_IMAGE=rpm-ds:1.0-blackwell-dev
DEV_IMAGE=mycareapp-dev
GPU_ID=0
MDX_DATA_DIR=/absolute/path/to/model-data

# Set to 0 only if you want DeepStream to start its own embedded Triton.
TRITON_EXTERNAL=1

TRITON_HTTP_PORT=8010
TRITON_GRPC_PORT=8011
TRITON_METRICS_PORT=8012

# RTSP publisher settings.
RTSP_HOST=127.0.0.1
RTSP_PORT=8554
STREAM_PREFIX=test
